#: dialogs.py:449
msgid "rate-mirrors tests all Arch mirrors and saves the fastest to /etc/pacman.d/mirrorlist"
msgstr "rate-mirrors prueba todos los espejos de Arch y guarda los más rápidos en /etc/pacman.d/mirrorlist"

#: dialogs.py:453
msgid "Countries"
msgstr "Países"

#: dialogs.py:454
msgid "Comma-separated country names, or blank for all"

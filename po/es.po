msgid "Saves existing list to mirrorlist-backup first"
msgstr "Guarda antes la lista actual en mirrorlist-backup"

#: dialogs.py:503
msgid "Max mirror delay (hours)"
msgstr "Retardo máximo de los espejos (horas)"

#: dialogs.py:504
msgid "Skip mirrors that are behind by more than this"
msgstr "Omite los espejos que van retrasados más de esto"

#: dialogs.py:512
msgid "Number of mirrors to keep"
msgstr "Número de espejos que conservar"

#: dialogs.py:513
msgid "0 = keep all ranked mirrors"
msgstr "0 = conservar todos los espejos clasificados"

#: dialogs.py:522
msgid "Find Fastest Mirrors"
msgstr "Buscar los espejos más rápidos"

#: dialogs.py:605
msgid "rate-mirrors not installed"
